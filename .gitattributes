* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.bb text eol=lf
*.bbappend text eol=lf
*.conf text eol=lf
*.patch text eol=lf whitespace=-trailing-space,-space-before-tab
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.S text eol=lf

