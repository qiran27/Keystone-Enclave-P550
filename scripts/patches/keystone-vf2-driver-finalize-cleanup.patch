diff --git a/keystone-ioctl.c b/keystone-ioctl.c
index 26cd3d4..06f18c6 100644
--- a/keystone-ioctl.c
+++ b/keystone-ioctl.c
@@ -77,17 +77,18 @@ int keystone_finalize_enclave(unsigned long arg)
 
   if (ret.error) {
     keystone_err("keystone_create_enclave: SBI call failed with error code %ld\n", ret.error);
-    goto error_destroy_enclave;
+    /*
+     * The userspace enclave ID and file private_data still refer to this
+     * object. Keep the partially initialized object alive so the normal
+     * DESTROY ioctl (or release()) can remove it from the IDR and free its
+     * EPM/UTM. Freeing it here leaves a dangling IDR entry and causes a
+     * second, invalid SBI destroy during userspace error cleanup.
+     */
+    return -EINVAL;
   }
 
   enclave->eid = ret.value;
 
   return 0;
-
-error_destroy_enclave:
-  /* This can handle partial initialization failure */
-  destroy_enclave(enclave);
-
-  return -EINVAL;
 
 }
