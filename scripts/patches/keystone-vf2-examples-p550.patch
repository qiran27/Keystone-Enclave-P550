diff --git a/attestation/host/verifier.cpp b/attestation/host/verifier.cpp
index 513ab07..77fb2cc 100644
--- a/attestation/host/verifier.cpp
+++ b/attestation/host/verifier.cpp
@@ -87,7 +87,11 @@ Verifier::compute_expected_sm_hash(byte* expected_sm_hash) {
   // measuring is the same as the size of the SM buffer allocated by
   // the bootloader. See keystone/bootrom/bootloader.c for how it is
   // computed in the bootloader.
-  const size_t sanctum_sm_size = 0x1ff000;
+  // On P550 the SM is integrated into OpenSBI, which has executed before its
+  // platform hook can initialize attestation. Measure the immutable RX
+  // region (_fw_start.._fw_rw_start), not the already-mutated data/BSS area.
+  // The pinned OpenSBI 1.6 link layout is asserted by the bootchain builder.
+  const size_t sanctum_sm_size = 0x40000;
   std::vector<byte> sm_content(sanctum_sm_size, 0);
 
   {
