+  return SBI_IPI_UPDATE_SUCCESS;
+}
+
+static void pmp_ipi_process(struct sbi_scratch *scratch)
+{
+  (void) scratch;
+  smp_rmb();
+  sbi_pmp_ipi_local_update(&pmp_ipi_command);
+  smp_wmb();
+  atomic_sub_return(&pmp_ipi_pending, 1);
+}
+
+static void pmp_ipi_sync(struct sbi_scratch *scratch)
+{
+  (void) scratch;
+  while (atomic_read(&pmp_ipi_pending))
+    cpu_relax();
+  smp_rmb();
+}
+
+static const struct sbi_ipi_event_ops pmp_ipi_ops = {
+  .name = "IPI_KEYSTONE_PMP",
+  .update = pmp_ipi_update,
+  .sync = pmp_ipi_sync,
+  .process = pmp_ipi_process,
+};
+
+int sbi_pmp_ipi_init(bool cold_boot)
+{
+  int event;
+
+  if (!cold_boot)
+    return pmp_ipi_event == SBI_IPI_EVENT_MAX ? SBI_ENODEV : 0;
+
+  atomic_write(&pmp_ipi_pending, 0);
+  event = sbi_ipi_event_create(&pmp_ipi_ops);
+  if (event < 0)
+    return event;
+
+  pmp_ipi_event = event;
+  return 0;
+}
+
+int send_and_sync_pmp_ipi(int region_idx, int type, uint8_t perm)
+{
+  int rc;
+
+  if (pmp_ipi_event == SBI_IPI_EVENT_MAX)
+    return SBI_ENODEV;
+
+  spin_lock(&pmp_ipi_lock);
+  pmp_ipi_command.type = type;
+  pmp_ipi_command.rid = region_idx;
+  pmp_ipi_command.perm = perm;
+  atomic_write(&pmp_ipi_pending, 0);
+  smp_wmb();
+
+  /* hbase == -1 selects all interruptible HARTs in the current domain. */
+  rc = sbi_ipi_send_many(0, -1UL, pmp_ipi_event, &pmp_ipi_command);
+  spin_unlock(&pmp_ipi_lock);
+
+  return rc;
 }
 
